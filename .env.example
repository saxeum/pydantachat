"""API keys only. Everything else lives in `config.json`.

Only the selected provider's key is read, so all three can stay here at once.
The names are the ones Pydantic AI reads: <PROVIDER>_API_KEY.
"""
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# --- Web API ---------------------------------------------------------------
# Shared Google OIDC client (same as zuchat). Register <APP_BASE_URL>/auth as
# an extra redirect URI on that client. The API refuses to start with any of
# these unset, and an empty ALLOWED_EMAILS admits nobody.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
SESSION_SECRET=
ALLOWED_EMAILS=
APP_BASE_URL=http://localhost:8000

# Set to false to disable /docs and /openapi.json when the service is exposed.
# ENABLE_DOCS=false
