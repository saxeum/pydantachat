# One API key per provider. The agent uses <PROVIDER>_API_KEY for whichever
# provider PROVIDER names, so keys for several providers can coexist.
DEEPSEEK_API_KEY=
OPENAI_API_KEY=
OPENROUTER_API_KEY=

# Provider and model name for Pydantic AI. Uncomment one block to switch.
# OpenRouter.
PROVIDER=openrouter
MODEL=nvidia/nemotron-3-super-120b-a12b

# DeepSeek.
# PROVIDER=deepseek
# MODEL=deepseek-flash

# OpenAI.
# PROVIDER=openai
# MODEL=gpt-5-nano

# Thinking/reasoning: true, false, or minimal|low|medium|high|xhigh|max.
# Leave empty to use the provider default (enabled for deepseek-flash).
THINKING_LEVEL=

# Tracing stays off while this is empty. Setting it turns tracing on and sends
# spans over OTLP/HTTP to whatever is listening there:
#   Phoenix   http://localhost:6006   (docker compose up -d)
#   Jaeger    http://localhost:4318
#   otel-tui  http://localhost:4318
OTEL_EXPORTER_OTLP_ENDPOINT=

# Span service name. Defaults to pydantachat, so only set it to change that.
# OTEL_SERVICE_NAME=pydantachat
